<resources>

    <!-- Base Theme -->
    <style name="Base.V21" parent="Theme.AppCompat.DayNight.NoActionBar">
       <item name="android:homeAsUpIndicator">@null</item>
    </style>
   <style name="Widget.App.MaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
    <item name="enforceMaterialTheme">false</item>
   </style>
    <style name="Base" parent="Base.V21"/>
    <!-- Light Theme -->
    <style name="Base.V21.LightTheme" parent="Base">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="windowBackground">@android:color/white</item>
        <item name="colorPrimaryDark">@android:color/white</item>
        <item name="colorAccent">#FF3EA6FF</item>
        <item name="colorPrimary">#000000</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E0E0E0</item>
        <item name="colorOnPrimaryContainer">#000000</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#000000</item>
        <item name="colorOnSurfaceVariant">#616161</item>
        <item name="colorSurfaceContainerHighest">#E0E0E0</item>
        <item name="colorOutline">#757575</item>
     </style>
     <style name="Base.LightTheme" parent="Base.V21.LightTheme" />
    <style name="LightTheme" parent="Base.LightTheme"/>

    <!-- Dark Theme -->
    <style name="Base.V21.DarkTheme" parent="Base">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="windowBackground">@android:color/black</item>
        <item name="colorPrimaryDark">@android:color/black</item>
        <item name="colorAccent">#FF065FD4</item>
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">#424242</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>
        <item name="colorSurface">#000000</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#BDBDBD</item>
        <item name="colorSurfaceContainerHighest">#303030</item>
        <item name="colorOutline">#9E9E9E</item>
    </style>
    <style name="Base.DarkTheme" parent="Base.V21.DarkTheme" />
    <style name="DarkTheme" parent="Base.DarkTheme"/>

    <!-- Black Theme -->
    <style name="Base.V21.BlackTheme" parent="DarkTheme">
    </style>
    <style name="Base.BlackTheme" parent="Base.V21.BlackTheme" />
    <style name="BlackTheme" parent="Base.BlackTheme"/>

    <!-- Dialogs -->
    <style name="LightDialogTheme" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="colorPrimary">@android:color/white</item>
        <item name="colorPrimaryDark">@android:color/white</item>
        <item name="colorAccent">@android:color/black</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="windowBackground">@android:color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="DarkDialogTheme" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="colorPrimary">@android:color/black</item>
        <item name="colorPrimaryDark">@android:color/black</item>
        <item name="colorAccent">@android:color/white</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="windowBackground">@android:color/black</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="LightDialogMinWidthTheme" parent="Theme.AppCompat.DayNight.Dialog.MinWidth">
    </style>

    <style name="DarkDialogMinWidthTheme" parent="Theme.AppCompat.DayNight.Dialog.MinWidth">
    </style>

    <!-- Settings -->
    <style name="LightSettingsTheme" parent="LightTheme">
    </style>

    <style name="DarkSettingsTheme" parent="DarkTheme">
    </style>

    <style name="BlackSettingsTheme" parent="BlackTheme">
    </style>

    <!--File picker styles-->
    <style name="FilePickerThemeLight" parent="NNF_BaseTheme.Light">
        <item name="actionColor">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="nnf_separator_color">@color/white</item>
        <item name="alertDialogTheme">@style/FilePickerAlertDialogThemeLight</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">@android:color/white</item>
        <item name="colorAccent">@android:color/black</item>
    </style>
    <style name="FilePickerThemeDark" parent="NNF_BaseTheme">
        <item name="actionColor">@color/white</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="nnf_separator_color">@android:color/black</item>
        <item name="alertDialogTheme">@style/FilePickerAlertDialogThemeDark</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@android:color/black</item>
        <item name="colorAccent">@android:color/white</item>
    </style>
    <style name="FilePickerAlertDialogThemeLight" parent="Theme.AppCompat.DayNight.Dialog.Alert">
    </style>
    <style name="FilePickerAlertDialogThemeDark" parent="Theme.AppCompat.DayNight.Dialog.Alert">
    </style>

    <!-- Router Activity -->
    <style name="Base.RouterActivityThemeLight" parent="LightTheme">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="RouterActivityThemeLight" parent="Base.RouterActivityThemeLight" />

    <style name="Base.RouterActivityThemeDark" parent="DarkTheme">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="RouterActivityThemeDark" parent="Base.RouterActivityThemeDark" />
    <style name="DownloadSheetTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Animation.Design.BottomSheetDialog</item>
        <item name="bottomSheetStyle">@style/DownloadSheet</item>
    </style>
    <style name="DownloadSheet" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_sheet</item>
    </style>


    <style name="MissionPopupText" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/dl_popup_text</item>
    </style>
    <style name="MissionPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupElevation">8dp</item>
    </style>
    <style name="MissionPopup">
        <item name="popupMenuStyle">@style/MissionPopupMenu</item>
        <item name="android:popupMenuStyle">@style/MissionPopupMenu</item>
        <item name="textAppearanceLargePopupMenu">@style/MissionPopupText</item>
    </style>

    <style name="DownloadsActionMode">
        <item name="windowActionModeOverlay">true</item>
        <item name="actionModeStyle">@style/DownloadsActionModeBar</item>
        <item name="actionModeCloseDrawable">@drawable/ic_close</item>
    </style>
    <style name="DownloadsActionModeBar" parent="Widget.AppCompat.ActionMode">
        <item name="background">?android:attr/colorBackground</item>
        <item name="backgroundSplit">?android:attr/colorBackground</item>
        <item name="titleTextStyle">@style/DownloadsActionModeTitle</item>
        <item name="subtitleTextStyle">@style/DownloadsActionModeSubtitle</item>
    </style>
    <style name="DownloadsActionModeTitle" parent="TextAppearance.AppCompat.Widget.ActionMode.Title">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="DownloadsActionModeSubtitle" parent="TextAppearance.AppCompat.Widget.ActionMode.Subtitle">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="DownloadsTitleExpanded" parent="TextAppearance.AppCompat">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="DownloadsTitleCollapsed" parent="TextAppearance.AppCompat">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
</resources>
