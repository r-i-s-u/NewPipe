<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/row_pressed" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:id="@+id/row_normal">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <transition android:fromId="@id/row_pressed" android:toId="@id/row_normal">
        <animation-list android:oneshot="true">
            <item android:duration="320">
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="@color/stroke_color" />
                </shape>
            </item>
            <item android:duration="1">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </animation-list>
    </transition>
</animated-selector>
