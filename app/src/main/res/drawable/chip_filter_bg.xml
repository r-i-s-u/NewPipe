<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/dl_chip_on"/>
            <stroke android:width="1dp" android:color="@color/dl_chip_on"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="1dp" android:color="@color/dl_outline"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</selector>
