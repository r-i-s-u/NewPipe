<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/sheet_row_pressed">
    <item>
        <selector>
            <item android:state_pressed="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="@color/sheet_row_pressed" />
                        </shape>
                    </item>
                    <item android:bottom="-1dp" android:left="-2dp" android:right="-2dp"
                        android:top="-1dp">
                        <shape android:shape="rectangle">
                            <stroke android:width="1dp" android:color="@color/stroke_color" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <inset android:insetLeft="12dp" android:insetRight="12dp">
            <shape android:shape="rectangle">
                <solid android:color="#FFFFFFFF" />
                <corners android:radius="20dp" />
            </shape>
        </inset>
    </item>
</ripple>
