<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/selection_bar_bg"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:visibility="gone">

    <CheckBox
        android:id="@+id/sel_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@drawable/download_checkbox_button"
        android:minWidth="0dp"
        android:minHeight="0dp" />

    <TextView
        android:id="@+id/sel_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/sel_share"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/download_icon_bg"
        android:contentDescription="@string/share"
        android:padding="12dp"
        android:src="@drawable/ic_share"
        android:tint="?android:attr/textColorPrimary" />

    <ImageView
        android:id="@+id/sel_delete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/download_icon_bg"
        android:contentDescription="@string/delete_file"
        android:padding="12dp"
        android:src="@drawable/ic_delete"
        android:tint="?android:attr/textColorPrimary" />
</LinearLayout>
